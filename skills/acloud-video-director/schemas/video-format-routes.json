            {
              "value": "existing_long_form",
              "label": "Extract it from a longer recording"
            },
            {
              "value": "product_assets",
              "label": "Build it from product or brand assets"
            },
            {
              "value": "trend_response",
              "label": "Respond to a current topic with sourced context"
            }
          ]
        },
        {
          "id": "captionStyle",
          "target": "routePlan.answers.captionStyle",
          "label": "How prominent should captions be?",
          "help": "Caption treatment affects framing and safe-area planning from the first storyboard.",
          "input": "single_choice",
          "required": true,
          "options": [
            {
              "value": "clean",
              "label": "Clean and understated"
            },
            {
              "value": "bold",
              "label": "Bold social captions"
            },
            {
              "value": "karaoke",
              "label": "Word-by-word emphasis"
            },
            {
              "value": "minimal",
              "label": "Minimal captions only when needed"
            }
          ]
        },
        {
          "id": "variantCount",
          "target": "routePlan.answers.variantCount",
          "label": "How many hook or edit variants should we plan?",
          "help": "Variants share approved source material but remain separate outputs for review.",
          "input": "number",
          "required": true,
          "min": 1,
          "max": 10,
          "unit": "variants"
        }
      ]
    },
