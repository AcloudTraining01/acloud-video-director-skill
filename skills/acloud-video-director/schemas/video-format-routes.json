{
  "questionnaireVersion": 1,
  "sharedQuestions": [
    {
      "id": "objective",
      "target": "brief.goal",
      "label": "What should this video help the viewer understand, feel, or do?",
      "help": "Describe one primary outcome. This becomes the creative north star and keeps later generation focused.",
      "input": "textarea",
      "required": true,
      "placeholder": "Explain the result this video should create for the viewer."
    },
    {
      "id": "audience",
      "target": "brief.audience",
      "label": "Who is this video for?",
      "help": "Name the audience, their current situation, and what they already know.",
      "input": "textarea",
      "required": true,
      "placeholder": "For example: first-time Etsy sellers who have listings but no repeatable promotion plan."
    },
    {
      "id": "platform",
      "target": "brief.platform",
      "label": "Where will the main version be watched?",
      "help": "Choose the primary destination. Additional deliverables can be requested later without changing the main route.",
      "input": "single_choice",
      "required": true,
      "options": [
        {
          "value": "youtube",
          "label": "YouTube"
        },
        {
          "value": "tiktok",
          "label": "TikTok"
        },
        {
          "value": "instagram",
          "label": "Instagram"
        },
        {
          "value": "facebook",
          "label": "Facebook"
        },
        {
          "value": "linkedin",
          "label": "LinkedIn"
        },
        {
          "value": "website",
          "label": "Website or landing page"
        },
        {
          "value": "download",
          "label": "Download or course portal"
        },
        {
          "value": "other",
          "label": "Another destination"
        }
      ]
    },
    {
      "id": "targetDurationSeconds",
      "target": "brief.targetDurationSeconds",
      "label": "How long should the main version be?",
      "help": "Use the route guidance as a starting point. Final scene timing must stay within the approved target.",
      "input": "number",
      "required": true,
      "min": 3,
      "max": 14400,
      "unit": "seconds"
    },
    {
      "id": "aspectRatio",
      "target": "brief.aspectRatio",
      "label": "Which frame should we design first?",
      "help": "Choose the primary canvas. Reframed variants remain separate reviewable outputs.",
      "input": "single_choice",
      "required": true,
      "options": [
        {
          "value": "16:9",
          "label": "Landscape \u00b7 16:9"
        },
        {
          "value": "9:16",
          "label": "Vertical \u00b7 9:16"
        },
        {
          "value": "1:1",
          "label": "Square \u00b7 1:1"
        },
        {
          "value": "4:5",
          "label": "Portrait feed \u00b7 4:5"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ]
    },
    {
      "id": "language",
      "target": "brief.language",
      "label": "What language should the finished video use?",
      "help": "Name the spoken and on-screen language. Translations require their own review.",
      "input": "text",
      "required": true,
      "placeholder": "English"
    },
    {
      "id": "tone",
      "target": "brief.tone",
      "label": "How should the video sound and feel?",
      "help": "Use plain creative direction such as calm and credible, playful and fast, or premium and minimal.",
      "input": "text",
      "required": true,
      "placeholder": "Clear, practical, and optimistic"
    },
    {
      "id": "callToAction",
      "target": "brief.callToAction",
      "label": "What should the viewer do next?",
      "help": "Leave this blank only when the format intentionally has no call to action.",
      "input": "text",
      "required": false,
      "placeholder": "Start the free trial"
    }
  ],
  "routes": [
    {
      "id": "long_form",
      "name": "Long-Form Video",
      "shortName": "Long Form",
      "referenceTerm": "Long-form video",
      "description": "Build a chaptered video with a sustained argument, tutorial, story, or lesson.",
      "bestFor": [
        "YouTube episodes",
        "training lessons",
        "deep tutorials",
        "case studies"
      ],
      "defaultPlatform": "youtube",
      "defaultAspectRatio": "16:9",
      "duration": {
        "minSeconds": 180,
        "maxSeconds": 3600,
        "recommendedSeconds": 600
      },
      "defaultCompositor": "hyperframes",
      "defaultCapabilities": [
        "research",
        "stock_search",
        "narration",
        "composition",
        "media_editing",
        "captions",
        "audio_mix",
        "quality_review",
        "export"
      ],
      "questions": [
        {
          "id": "sourceStage",
          "target": "routePlan.answers.sourceStage",
          "label": "What are we starting from?",
          "help": "This determines whether the first production step is research, outlining, script adaptation, or transcript editing.",
          "input": "single_choice",
          "required": true,
          "options": [
            {
              "value": "topic_only",
              "label": "A topic or rough idea"
            },
            {
              "value": "outline",
              "label": "An approved outline"
            },
            {
              "value": "finished_script",
              "label": "A finished script"
            },
            {
              "value": "existing_recording",
              "label": "An existing recording"
            }
          ]
        },
        {
          "id": "narrativeShape",
          "target": "routePlan.answers.narrativeShape",
          "label": "Which structure best fits the story?",
          "help": "Choose the dominant structure; individual chapters can still vary.",
          "input": "single_choice",
          "required": true,
          "options": [
            {
              "value": "tutorial",
              "label": "Step-by-step tutorial"
            },
            {
              "value": "documentary",
              "label": "Documentary narrative"
            },
            {
              "value": "case_study",
              "label": "Case study"
            },
            {
              "value": "list",
              "label": "Numbered or ranked list"
            },
            {
              "value": "commentary",
              "label": "Commentary or analysis"
            }
          ]
        },
        {
          "id": "sectionCount",
          "target": "routePlan.answers.sectionCount",
          "label": "How many major sections should it contain?",
          "help": "Count chapters, not individual shots.",
          "input": "number",
          "required": true,
          "min": 3,
          "max": 20,
          "unit": "sections"
        },
        {
          "id": "visualApproach",
          "target": "routePlan.answers.visualApproach",
          "label": "What should carry the visuals?",
          "help": "Pick the main visual system so the storyboard does not become an inconsistent mix of styles.",
          "input": "single_choice",
          "required": true,
          "options": [
            {
              "value": "mixed_media",
              "label": "A controlled mix of footage, graphics, and text"
            },
            {
              "value": "screen_led",
              "label": "Screen recordings and interface demonstrations"
            },
            {
              "value": "stock_led",
              "label": "Licensed footage and source-led B-roll"
            },
            {
              "value": "presenter_led",
              "label": "A presenter or supplied talking-head recording"
            },
            {
              "value": "motion_graphics",
              "label": "Motion graphics, diagrams, and typography"
            }
          ]
        },
        {
          "id": "researchStandard",
          "target": "routePlan.answers.researchStandard",
          "label": "What evidence standard should the script follow?",
          "help": "Current research adds source work and review. It never authorizes copying or unsupported claims.",
          "input": "single_choice",
          "required": true,
          "options": [
            {
              "value": "user_sources_only",
              "label": "Use only sources I provide"
            },
            {
              "value": "current_web_research",
              "label": "Research current public sources"
            },
            {
              "value": "source_every_claim",
              "label": "Require a source for every factual claim"
            }
          ]
        }
      ]
    },
    {
      "id": "short_form",
      "name": "Social Short",
      "shortName": "Social Short",
      "referenceTerm": "Short-form video",
      "description": "Create a fast vertical or square video with one hook, one payoff, and one next action.",
      "bestFor": [
        "TikTok",
        "Instagram Reels",
        "YouTube Shorts",
        "paid social"
      ],
      "defaultPlatform": "instagram",
      "defaultAspectRatio": "9:16",
      "duration": {
        "minSeconds": 6,
        "maxSeconds": 90,
        "recommendedSeconds": 30
      },
      "defaultCompositor": "ffmpeg",
      "defaultCapabilities": [
        "composition",
        "media_editing",
        "captions",
        "audio_mix",
        "quality_review",
        "export"
      ],
      "questions": [
        {
          "id": "shortPurpose",
          "target": "routePlan.answers.shortPurpose",
          "label": "What job should this short do?",
          "help": "A short performs better when it has one job instead of several competing goals.",
          "input": "single_choice",
          "required": true,
          "options": [
            {
              "value": "educate",
              "label": "Teach one useful idea"
            },
            {
              "value": "promote",
              "label": "Promote an offer or product"
            },
            {
              "value": "entertain",
              "label": "Entertain or tell a quick story"
            },
            {
              "value": "announce",
              "label": "Make an announcement"
            },
            {
              "value": "extract_highlight",
              "label": "Turn an existing moment into a highlight"
            }
          ]
        },
        {
          "id": "openingHook",
          "target": "routePlan.answers.openingHook",
          "label": "What should earn attention in the first two seconds?",
          "help": "State the tension, result, surprise, or visual action. Avoid vague introductions.",
          "input": "textarea",
          "required": true,
          "placeholder": "For example: Show the finished dashboard before explaining how it was built."
        },
        {
          "id": "sourceMode",
          "target": "routePlan.answers.sourceMode",
          "label": "Where should the short come from?",
          "help": "This separates original creation from transcript-led repurposing and product-asset editing.",
